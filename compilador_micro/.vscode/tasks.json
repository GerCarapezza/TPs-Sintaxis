{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build_debug (windows)",
            "type": "shell",
            "command": "gcc.exe",
            "args": [
                "-g",
                "-Wall",
                "prueba.c",
                "-o",
                "${workspaceFolder}\\mi_programa.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Compila el archivo C actual con gcc.exe para debuggear."
        }
    ]
}